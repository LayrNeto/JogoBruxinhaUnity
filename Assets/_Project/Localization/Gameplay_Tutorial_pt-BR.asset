MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Gameplay_Tutorial_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 6741925cc682c1845b875a8926a0c3bf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 137478750208
    m_Localized: "Bom dia, Cora. Prepare-se para a li\xE7\xE3o de magia de hoje."
    m_Metadata:
      m_Items: []
  - m_Id: 788086603776
    m_Localized: "Bom dia, irm\xE3! J\xE1 estou pronta!"
    m_Metadata:
      m_Items: []
  - m_Id: 912351248384
    m_Localized: "\xD3timo. A li\xE7\xE3o de hoje \xE9 importante. Irei te ensinar
      a fazer po\xE7\xF5es com propriedades curativas."
    m_Metadata:
      m_Items: []
  - m_Id: 931456303104
    m_Localized: "Como as que voc\xEA usa nos seus pacientes?"
    m_Metadata:
      m_Items: []
  - m_Id: 941979811840
    m_Localized: "Exato. Voc\xEA vem avan\xE7ando bastante em seus estudos e j\xE1
      est\xE1 chegando a hora de come\xE7ar a me ajudar a tratar os alde\xF5es do
      vilarejo."
    m_Metadata:
      m_Items: []
  - m_Id: 955246395392
    m_Localized: "Imagine que eu fui atacada por uma criatura m\xE1gica e agora estou
      com feridas abertas, sentindo dor e enjoo. Lembre-se dessas informa\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 966231277568
    m_Localized: "Para fazer uma po\xE7\xE3o, \xE9 necess\xE1rio ter ingredientes.
      V\xE1 para a estufa e colha todas as plantas que estiverem dispon\xEDveis.
      Em seguida, me encontre no caldeir\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1255663419392
    m_Localized: "V\xE1 coletar os ingredientes, volte aqui depois."
    m_Metadata:
      m_Items: []
  - m_Id: 1568822738944
    m_Localized: Pegou tudo? Excelente.
    m_Metadata:
      m_Items: []
  - m_Id: 1742471118848
    m_Localized: "Todos os seres vivos carregam em si uma quantidade de energia vital.
      Essa energia \xE9 capaz de curar ferimentos, doen\xE7as e at\xE9 certas maldi\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 1747042910208
    m_Localized: "Ao criar uma po\xE7\xE3o de cura, canalizamos a energia vital das
      plantas. Usamos sempre 3 ingredientes para atingir a quantidade de energia
      necess\xE1ria."
    m_Metadata:
      m_Items: []
  - m_Id: 1770321297408
    m_Localized: "Cada planta tem uma propriedade curativa diferente. \xC9 importante
      conhec\xEA-las para criar a po\xE7\xE3o certa para ajudar o paciente. Voc\xEA
      pode consultar sobre isso sempre que quiser, no livro pr\xF3ximo ao caldeir\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1779129335808
    m_Localized: "Lembra-se dos sintomas que eu citei antes? Crie uma po\xE7\xE3o
      que seja capaz de cur\xE1-los."
    m_Metadata:
      m_Items: []
  - m_Id: 1787400503296
    m_Localized: "Essa po\xE7\xE3o parece satisfat\xF3ria. V\xE1 para o balc\xE3o
      novamente para entregar a po\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2254234927104
    m_Localized: Excelente, Cora.
    m_Metadata:
      m_Items: []
  - m_Id: 2604824215552
    m_Localized: "Agora, irei te ensinar um outro m\xE9todo de criar po\xE7\xF5es.
      Me encontre no caldeir\xE3o novamente."
    m_Metadata:
      m_Items: []
  - m_Id: 2700471123968
    m_Localized: "Como eu falei, a energia vital dos seres vivos \xE9 o que usamos
      para curar. A energia que existe nas plantas funciona bem, mas \xE9 limitada."
    m_Metadata:
      m_Items: []
  - m_Id: 3301439389696
    m_Localized: "Existe um feiti\xE7o que te permite canalizar sua pr\xF3pria energia
      vital para a po\xE7\xE3o. A energia humana \xE9 potente e vers\xE1til."
    m_Metadata:
      m_Items: []
  - m_Id: 3315586777088
    m_Localized: "Usar sua energia vital garantir\xE1 que a po\xE7\xE3o cure o paciente,
      independente da efic\xE1cia dos ingredientes. Por\xE9m, utiliz\xE1-la significa
      gastar um pouco do que te mant\xE9m viva."
    m_Metadata:
      m_Items: []
  - m_Id: 3324281569280
    m_Localized: "Ao dormir, parte da sua energia vital \xE9 restaurada."
    m_Metadata:
      m_Items: []
  - m_Id: 3334691831808
    m_Localized: "Com tempo e pr\xE1tica, voc\xEA aprender\xE1 a aproveitar melhor
      sua energia vital. Por hora, voc\xEA s\xF3 ser\xE1 capaz de usar uma vez ao
      dia sem se prejudicar."
    m_Metadata:
      m_Items: []
  - m_Id: 3344393256960
    m_Localized: "Bom, vamos come\xE7ar. Primeiro, junte 3 ingredientes no caldeir\xE3o.
      Como vamos utilizar o feiti\xE7o, sua escolha de ingredientes n\xE3o importa."
    m_Metadata:
      m_Items: []
  - m_Id: 3532356796416
    m_Localized: "\xD3timo. Agora, antes de completar a po\xE7\xE3o, abra o livro
      de anota\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 4038424739840
    m_Localized: "Ops\u2026 Acho que pronunciei uma palavra errado\u2026 Ser\xE1
      que estraguei o feiti\xE7o?"
    m_Metadata:
      m_Items: []
  - m_Id: 4204728893440
    m_Localized: "Oh n\xE3o\u2026 O que foi que eu fiz?"
    m_Metadata:
      m_Items: []
  - m_Id: 4303211151360
    m_Localized: "Tenho que dar um jeito nisso. Preciso encontrar uma solu\xE7\xE3o!
      E ainda preciso cumprir o papel de curandeira da minha irm\xE3 e ajudar os
      alde\xF5es!"
    m_Metadata:
      m_Items: []
  - m_Id: 4447180636160
    m_Localized: "Olhe o livro para n\xE3o fazer besteira."
    m_Metadata:
      m_Items: []
  - m_Id: 4790744465408
    m_Localized: "Meus sintomas s\xE3o feridas abertas, dor e enjoo."
    m_Metadata:
      m_Items: []
  - m_Id: 4951340171264
    m_Localized: "Abra o livro para finalizar a po\xE7\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 12607442337792
    m_Localized: "Al\xE9m das informa\xE7\xF5es sobre os ingredientes, o livro tamb\xE9m
      cont\xE9m as instru\xE7\xF5es para fazer o feiti\xE7o."
    m_Metadata:
      m_Items: []
  - m_Id: 12623082897408
    m_Localized: "O s\xEDmbolo est\xE1 na \xFAltima p\xE1gina."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
